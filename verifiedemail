<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email Verificeret - HoppOn</title>
    <link rel="icon" href="https://i.imgur.com/4oGYz8n.png" type="image/png">
    <style>
        :root {
            /* HoppOn Brand Colors */
            --slate-900: #0F172A;
            --indigo-500: #6366F1;
            --indigo-600: #4F46E5;
            --green-500: #22c55e; /* Success Color */
            --slate-100: #F1F5F9;
            --white: #FFFFFF;
            
            /* Glassmorphism Settings */
            --glass-bg: rgba(255, 255, 255, 0.85);
            --glass-border: rgba(255, 255, 255, 0.6);
            --shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.15);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            height: 100vh;
            width: 100%;
            background: radial-gradient(circle at top right, #E0E7FF 0%, #F8FAFC 60%, #FFFFFF 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--slate-900);
            overflow: hidden;
        }

        .container {
            background: var(--glass-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--glass-border);
            padding: 3rem 2rem;
            border-radius: 32px;
            box-shadow: var(--shadow);
            text-align: center;
            max-width: 420px;
            width: 90%;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.5rem;
            animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* Logo Styling */
        .logo-container {
            width: 70px;
            height: 70px;
            background: transparent;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0.5rem;
            overflow: hidden;
        }

        .logo-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Success Icon Styling */
        .success-icon-wrapper {
            width: 80px;
            height: 80px;
            background: #dcfce7; /* Light Green Bg */
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: -10px;
            animation: scaleIn 0.5s ease-out 0.3s backwards;
        }

        .success-icon {
            width: 40px;
            height: 40px;
            color: var(--green-500);
        }

        /* Typography */
        h1 {
            font-size: 2rem;
            font-weight: 800;
            color: var(--slate-900);
            line-height: 1.1;
        }

        p.message {
            font-size: 1.05rem;
            color: #475569;
            line-height: 1.5;
            margin-bottom: 0.5rem;
        }

        /* Button */
        .btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            background: var(--slate-900);
            color: var(--white);
            text-decoration: none;
            padding: 16px;
            border-radius: 16px;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .btn:hover {
            transform: translateY(-2px);
            background: var(--indigo-500);
            box-shadow: 0 10px 20px -5px rgba(99, 102, 241, 0.4);
        }

        .divider {
            height: 1px;
            width: 100%;
            background: linear-gradient(90deg, transparent, rgba(15, 23, 42, 0.1), transparent);
            margin: 0.5rem 0;
        }

        footer {
            font-size: 0.75rem;
            color: #94A3B8;
        }

        /* Animations */
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(40px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        @keyframes scaleIn {
            from { transform: scale(0); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="logo-container">
            <img src="https://i.imgur.com/4oGYz8n.png" alt="HoppOn Logo" class="logo-img">
        </div>

        <div class="success-icon-wrapper">
            <svg class="success-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
        </div>

        <div>
            <h1>Succes!</h1>
            <p class="message" style="margin-top: 10px;">
                Din email er nu verificeret.<br>
                Du er klar til at køre med HoppOn.
            </p>
        </div>

        <div class="divider"></div>

        <a href="#" class="btn">
            Åbn HoppOn Appen
        </a>

        <footer>
            &copy; 2026 HoppOn. Alle rettigheder forbeholdes.
        </footer>
    </div>

</body>
</html>
